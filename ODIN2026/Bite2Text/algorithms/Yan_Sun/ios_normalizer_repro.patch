+def _prediction_metrics(logits):
+    maximum = max(logits)
+    exponentials = [math.exp(value - maximum) for value in logits]
+    total = sum(exponentials)
+    probabilities = [value / total for value in exponentials]
+    ranked_logits = sorted(logits, reverse=True)
+    ranked_probabilities = sorted(probabilities, reverse=True)
+    return {
+        "probabilities": probabilities,
+        "confidence": ranked_probabilities[0],
+        "probability_margin": ranked_probabilities[0] - ranked_probabilities[1],
+        "logit_margin": ranked_logits[0] - ranked_logits[1],
+    }
+
